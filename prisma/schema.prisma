// TASKS — database schema.
//
// Deployed on PostgreSQL (Neon). Was SQLite during local-only development
// (see git history) — "enum" fields (role, status, priority...) stayed
// String rather than being converted to native Postgres enums: they were
// already validated in code (API routes) against a fixed list, native
// enums would need a migration of their own with no real benefit yet, and
// keeping them as String avoids widening this first deploy's risk. Can
// still be revisited later if needed.
//
// Two connection strings (see .env.example), both provided automatically
// by the Vercel↔Neon integration (Storage tab): `url` is the pooled one
// (PgBouncer) used at runtime by the app; `directUrl` is the unpooled one
// (Vercel names it DATABASE_URL_UNPOOLED), used only by
// `prisma migrate`/`prisma db push` — Prisma Migrate doesn't work
// reliably through a connection pooler.
//
// Accounts/companies follow the same pattern as houses: a "User" is a
// pure login account, "Company" is owned directly by a User (ownerId),
// and "Agent" links a User to a Company as staff, with a role scoped to
// that company. A User can own several Companies and/or be an Agent in
// others — see the signup/login flow in the specs doc for the full
// process.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Models ----------

// Login account, independent of any company (mirrors "Account" in houses).
model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  country      String // ISO 3166-1 alpha-2 (e.g. "CI", "FR") — see lib/countries.ts
  // International format, e.g. "+225XXXXXXXXX" (composed at signup from the
  // chosen country's dial code + the locally-typed number — see
  // composeInternationalPhone() in lib/phone.ts). Also the number used for
  // WhatsApp alerts, so it must stay a real, reachable number.
  phone        String   @unique
  // Nullable at the DB level (existing accounts may not have one), but the
  // new "invite a teammate" flow (POST /api/agents + /api/agents/invite)
  // requires it — it's how the invite link gets delivered, and how
  // someone can log in with either their phone or their email (see
  // POST /api/auth/login). Always stored lowercased/trimmed.
  email        String?  @unique
  passwordHash String
  // Null means this account hasn't chosen its own password yet — true for
  // every account created by the "invite a teammate" flow (see
  // POST /api/agents/invite), which sets an unusable random placeholder
  // hash and mails a one-time link instead (see accept-invite/route.ts and
  // app/set-password). Set immediately at self-signup (POST
  // /api/auth/signup) and the moment an invited account completes
  // app/set-password. dashboard/layout.tsx redirects here first, before
  // anything else, whenever it's still null — see needsPasswordSetup() in
  // lib/auth.ts.
  passwordSetAt DateTime?
  avatarUrl    String?
  createdAt    DateTime @default(now())

  ownedCompanies Company[] @relation("CompanyOwner")
  agentRoles     Agent[]

  @@map("users")
}

// Deleting a Company cascades to everything scoped to it (agents, tasks
// and their subtasks/assignments/comments/notifications, groups) via
// `onDelete: Cascade` on each child relation below — see DELETE
// /api/companies/[id]. It does NOT cascade to the owning User.
model Company {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("free")
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation("CompanyOwner", fields: [ownerId], references: [id])

  agents Agent[]
  tasks  Task[]
  groups Group[]

  @@map("companies")
}

// A team/department within a company (e.g. "Ventes", "Support") — used to
// group agents for reporting (see the dashboard's per-group progress
// section) and, later, could gate task visibility. Membership is set when
// the group is created and can be changed afterward — an agent can belong
// to several groups at once (implicit many-to-many below), and one with
// no group at all is shown as "Sans groupe" rather than being required to
// join one.
model Group {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  // Who created this group — an ADMIN can edit/delete any group, but a
  // MANAGER only the ones they created themselves (see PATCH/DELETE
  // /api/groups/[id]). Nullable/SetNull so a group survives its creator
  // being removed from the company (it just becomes admin-only to manage
  // from then on, same fallback as a group created before this field
  // existed).
  creatorId String?
  creator   Agent?   @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  agents Agent[]
  // Tasks explicitly assigned to this group (the group chip was used on
  // that task, not merely "some of its members happen to be individually
  // assigned") — see Task.assignedGroups and the dashboard's per-group
  // progress, which relies on this relation rather than inferring group
  // membership from individual assignments.
  assignedTasks Task[]

  @@map("groups")
}

// Links a User to a Company as staff, with the role scoped to that
// company. Being the Company owner is a separate, direct relation
// (Company.ownerId) — an owner may also hold an Agent record in their own
// company (e.g. to be assignable on tasks) while keeping full access.
model Agent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // "ADMIN" | "MANAGER" | "MEMBER" (scoped to this company)
  // Implicit many-to-many (Prisma manages the join table) — an agent can
  // be in zero, one, or several groups.
  groups    Group[]
  joinedAt  DateTime @default(now())

  // Which admin/manager's own action brought this account into the
  // company — via POST /api/agents (linking an existing account) or
  // POST /api/agents/invite (creating a brand new one). Used to restrict a
  // MANAGER's reach: they may only manage (share the login link for,
  // remove) accounts they themselves added — see canManageAgent() in
  // lib/agents.ts. Same nullable/SetNull pattern as Group.creatorId: null
  // for every agent that predates this column (or the company's very
  // first agent, created directly by POST /api/companies, not through
  // either of those routes), and it just falls back to admin-only from
  // then on if the creator later leaves the company.
  createdByAgentId String?
  createdBy        Agent?   @relation("AgentCreator", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  createdAgents     Agent[]  @relation("AgentCreator")

  createdTasks  Task[]         @relation("TaskCreator")
  createdGroups Group[]        @relation("GroupCreator")
  assignments   Assignment[]
  comments      Comment[]
  notifications Notification[]

  @@unique([userId, companyId])
  @@map("agents")
}

model Task {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("TODO") // "TODO" | "IN_PROGRESS" | "DONE" | "BLOCKED"
  priority    String    @default("NORMAL") // "LOW" | "NORMAL" | "HIGH" | "URGENT"
  progress    Int       @default(0) // 0-100, edited mainly while status is IN_PROGRESS; set to 100 automatically when status becomes DONE (and vice versa: reaching 100 forces status to DONE — see PATCH /api/tasks/[id] and the subtasks routes)
  dueDate     DateTime?
  // Set the moment `status` becomes DONE (by any path), cleared if it ever
  // moves away from DONE again — used to compare against `dueDate` for the
  // "on time / early / late" performance readout on a finished task (see
  // TaskDetail.tsx). Distinct from `updatedAt`, which changes on ANY edit,
  // not just completion.
  completedAt DateTime?
  creatorId   String
  creator     Agent     @relation("TaskCreator", fields: [creatorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments   Assignment[]
  comments      Comment[]
  notifications Notification[]
  // Checkable steps this task has been broken down into — see Subtask's
  // own comment. Once this is non-empty, `progress` is derived from these
  // (sum of DONE subtasks' weight) rather than settable by hand.
  subtasks      Subtask[]
  // Groups this task is explicitly assigned to — distinct from
  // `assignments`, which is per-agent. Assigning a task to individual
  // agents who happen to belong to a group does NOT add it here; only
  // picking the group itself (its chip in AssigneePicker) does. This is
  // what the dashboard's "Avancement par groupe" counts against, so a
  // group's stats only reflect tasks it was actually assigned, not every
  // task any of its members happens to be on.
  assignedGroups Group[]

  @@map("tasks")
}

// A task broken down into smaller checkable steps by whoever's working on
// it (its creator, an assignee, or an admin/manager — see the permission
// checks in app/api/tasks/[id]/subtasks). `weight` is that subtask's share
// of the task's overall progress, in percentage points — the full set for
// one task must always sum to exactly 100. New subtasks default to an
// equal split (see lib/subtasks.ts's equalWeights()) and can be
// rebalanced afterward to reflect each one's actual complexity. The
// task's own `progress` is then just the sum of the weights of its DONE
// subtasks — kept in sync server-side every time a subtask is toggled,
// reweighted, added or removed (see the subtasks API routes), so once a
// task has subtasks, its progress is no longer set by hand.
model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  weight    Int      @default(0) // percentage points (0-100), all of one task's subtasks sum to 100
  done      Boolean  @default(false)
  order     Int      @default(0) // display order, set once at creation (append-only)
  createdAt DateTime @default(now())

  @@map("subtasks")
}

model Assignment {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([taskId, agentId])
  @@map("assignments")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Agent    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
